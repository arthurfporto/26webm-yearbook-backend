meta {
  name: Atualizar aluno sem token
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/alunos/1
  body: json
  auth: none
}

body:json {
  {
    "cidade": "Montes Claros",
    "frase": "Frase atualizada"
  }
}

tests {
  test("deve retornar 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
