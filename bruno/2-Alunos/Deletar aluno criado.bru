meta {
  name: Deletar aluno criado
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/alunos/{{alunoCriadoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("deve retornar status 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  DELETE /alunos exige ADMIN. Faça login como admin
  (admin@email.com / admin123) antes de rodar este cleanup.
}
