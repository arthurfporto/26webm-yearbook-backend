meta {
  name: Buscar aluno
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/alunos/1
  body: none
  auth: none
}

tests {
  test("deve retornar status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("não deve retornar senhaHash", function() {
    expect(res.getBody()).to.not.have.property('senhaHash');
  });
  
  test("deve retornar o aluno correto", function() {
    expect(res.getBody().id).to.equal(1);
  });
}
