meta {
  name: Criar mensagem
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mensagens
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "texto": "O cachorro está indo embora"
  }
}

script:post-response {
  bru.setVar("mensagemCriadaId", res.getBody().id);
}

tests {
  test("deve retornar status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("deve conter o texto enviado", function() {
    expect(res.getBody().texto).to.equal('O cachorro está indo embora');
  });
  
  test("deve retornar id gerado", function() {
    expect(res.getBody()).to.have.property('id');
  });
}
