meta {
  name: Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/status
  body: none
  auth: none
}

tests {
  test("deve retornar status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("deve retornar status ok", function() {
    expect(res.getBody().status).to.equal('ok');
  });

  test("deve retornar timestamp", function() {
    expect(res.getBody()).to.have.property('timestamp');
  });
}
